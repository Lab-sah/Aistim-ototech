{
  "manifest_version": 3,
  "name": "Ototech Tab",
  "version": "1.1.1",
  "description": "Tab baru berisi jam, kata-kata harian, dan menu pintasan: tambah, ubah, dan hapus link dengan ikon otomatis dari situsnya.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "key": ""
}
